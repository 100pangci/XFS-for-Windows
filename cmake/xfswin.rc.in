#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XFS-for-Windows contributors\0"
            VALUE "FileDescription", "XFS filesystem CLI and automount service\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "xfswin\0"
            VALUE "LegalCopyright", "Copyright (c) XFS-for-Windows contributors. MPL-2.0.\0"
            VALUE "OriginalFilename", "xfswin.exe\0"
            VALUE "ProductName", "XFS-for-Windows\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "Comments", "git=@XFSWIN_GIT_SHA@;arch=@XFSWIN_BUILD_ARCH@;configuration=@XFSWIN_BUILD_CONFIGURATION@;production=@XFSWIN_PRODUCTION_BUILD@;dirty=@XFSWIN_SOURCE_TREE_DIRTY@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
