<?xml version="1.0" encoding="utf-8"?>
<!--
  XFS for Windows REL-1 per-machine MSI.

  Product.wxs owns the full MSI transaction.  The maintenance helper is the
  installed xfswin.exe for the operations that are safe after InstallFiles
  (apply/verify/remove), and an MSI Binary copy of the same executable for the
  operations that must run before the product payload exists or after it was
  rolled back (prepare/rollback/commit).  The helper never derives its target
  from its own temporary/MSI path: every invocation passes the stable
  [APPLICATIONROOTDIRECTORY]\xfswin.exe explicitly.

  Maintenance helper contract, implemented by src/deployment and the CLI
  (option names are shown without their leading double dash because an XML
  comment may not contain two consecutive hyphens):
    xfswin installer prepare  action=install|upgrade|uninstall
        install-path=<absolute installed xfswin.exe>
    xfswin installer apply    action=install|upgrade install-path=<...>
    xfswin installer verify   action=install|upgrade install-path=<...>
    xfswin installer remove   action=uninstall install-path=<...>
    xfswin installer commit   action=auto install-path=<...>
    xfswin installer rollback action=auto install-path=<...>
        (after MSI restored the files)
    xfswin installer rollback-quiesce action=auto install-path=<...>
        (before MSI restores the files)
  A sequence condition is evaluated when Windows Installer builds the execute
  script, not when a rollback or commit action runs, so every rollback and
  commit row carries NOT UPGRADINGPRODUCTCODE: the old package's nested
  uninstall during RemoveExistingProducts must never touch the shared
  maintenance state.  Inside the active package each row runs exactly once and
  passes the auto action; the helper derives the operation from the fence and
  capture written by prepare.  The fail-stage
  option is the installer-only failure-injection switch used by the tests
  (before-service, after-files, service-start, verify).
  Every relevant unknown/failure returns nonzero.  The helper and every mount
  session share the startup mutex/file-lock protocol; this MSI therefore never
  writes SCM records, never stops/starts sessions on its own, never scans XFS
  media and never touches %ProgramData%\xfswin.

  Identifiers are stable across builds.  ProductCode is auto-generated per
  build; the product UpgradeCode ({7C4E2D19-6B8A-4F53-A1D0-3E9B5C7A2F64}) and
  the component GUIDs are stable so a major upgrade can remove the old package
  and reinstall the same component paths cleanly.  This UpgradeCode is the
  XFS-for-Windows product identity: it is deliberately distinct from the
  official WinFsp UpgradeCode ({5466A3D8-3AA1-4240-B6A0-3A051940A3EC}) so the
  shared runtime is never treated as a related product of this package.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="XFS for Windows"
           Manufacturer="XFS-for-Windows contributors"
           Version="$(var.ProductVersion)"
           ProductCode="*"
           UpgradeCode="{7C4E2D19-6B8A-4F53-A1D0-3E9B5C7A2F64}"
           Scope="perMachine"
           Compressed="yes"
           Language="1033">

    <!-- RemoveExistingProducts after InstallExecute.  The first elevated script
         runs prepare and InstallFiles while the old product still exists.
         After the old product's uninstall, the second script registers the
         rollback quiesce action before applying and verifying the new service.
         Rollback therefore stops that service before restoring the old product
         and files.  Every service row of the old package's nested uninstall is
         conditioned on NOT UPGRADINGPRODUCTCODE, so only the new package
         touches the service and the shared maintenance state. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of XFS for Windows is already installed."
                  Schedule="afterInstallExecute" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Per-machine, non-advertised install.  Repair/Modify would rewrite the
         installed executable under live mount sessions, which the runtime
         contract refuses; ordinary uninstall still works. -->
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Never let Windows Installer force-kill processes or silently replace a
         binary in use through Restart Manager, and do not request a reboot. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Property Id="REBOOT" Value="ReallySuppress" />

    <!-- MSI log for the installer's native log; Burn also writes its own. -->
    <Property Id="MsiLogging" Value="voicewarmupx" />

    <!-- Remember the installed location across major upgrades.  ProgramFiles64
         is the 64-bit Program Files view on native x64 and arm64 Windows. -->
    <Property Id="APPLICATIONROOTDIRECTORY">
      <RegistrySearch Id="ExistingInstallRoot" Root="HKLM"
                      Key="Software\XFS-for-Windows"
                      Name="InstallRoot" Type="raw" Bitness="always64" />
    </Property>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="APPLICATIONROOTDIRECTORY" Name="XFS-for-Windows">
          <Directory Id="DOCSDIRECTORY" Name="docs" />
          <Directory Id="NOTICESDIRECTORY" Name="THIRD-PARTY-NOTICES" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="XfsWinMenuFolder" Name="XFS for Windows" />
      </Directory>
    </Directory>

    <!-- Payload staged by the cmake install step into PayloadDir: xfswin.exe,
         LICENSE, README.md, version.json, the six selected documentation files
         and third-party notices.  No build output and no WinFsp DLL. -->
    <DirectoryRef Id="APPLICATIONROOTDIRECTORY">
      <Component Id="XfswinExe" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E01}">
        <File Id="XfswinExeFile" Source="$(var.PayloadDir)\xfswin.exe"
              KeyPath="yes" Checksum="yes" />
        <!-- Best-effort removal of the product root.  Windows Installer only
             deletes an empty directory, so the docs and notices components
             have their own RemoveFolder rows for the subdirectories.  A
             non-empty leftover directory is harmless and contains no product
             files. -->
        <RemoveFolder Id="ZRemoveApplicationRootDirectory" On="uninstall" />
      </Component>
      <Component Id="ProductLicense" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E02}">
        <File Id="ProductLicenseFile" Source="$(var.PayloadDir)\LICENSE"
              KeyPath="yes" />
      </Component>
      <Component Id="ProductReadme" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E03}">
        <File Id="ProductReadmeFile" Source="$(var.PayloadDir)\README.md"
              KeyPath="yes" />
      </Component>
      <Component Id="ProductVersionJson" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E04}">
        <File Id="ProductVersionJsonFile"
              Source="$(var.PayloadDir)\version.json" KeyPath="yes" />
      </Component>

      <!-- System PATH entry, removed on ordinary uninstall.  The registry
           value is the component keypath. -->
      <Component Id="SystemPath" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E05}">
        <Environment Id="XfsWinPath" Name="PATH"
                     Value="[APPLICATIONROOTDIRECTORY]"
                     Action="set" Part="last" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\XFS-for-Windows\Components"
                       Name="SystemPath" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- ARP metadata and the remembered install root used by subsequent
           upgrades.  Service context is captured by the helper. -->
      <Component Id="ProductRegistration"
                 Guid="{E0AB8D42-3A1F-4C2E-9E5B-6D4B5A1C7B22}">
        <RegistryKey Root="HKLM" Key="Software\XFS-for-Windows">
          <RegistryValue Name="InstallRoot" Type="string"
                         Value="[APPLICATIONROOTDIRECTORY]" KeyPath="yes" />
          <RegistryValue Name="Version" Type="string"
                         Value="$(var.ProductVersion)" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DOCSDIRECTORY">
      <Component Id="InstallGuide" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E06}">
        <File Id="InstallGuideFile"
              Source="$(var.PayloadDir)\docs\INSTALL.md" KeyPath="yes" />
        <RemoveFolder Id="RemoveDocsDirectory" On="uninstall" />
      </Component>
      <Component Id="InstallerGuide" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E0A}">
        <File Id="InstallerGuideFile"
              Source="$(var.PayloadDir)\docs\INSTALLER.md" KeyPath="yes" />
      </Component>
      <Component Id="ReleaseGuide" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E0B}">
        <File Id="ReleaseGuideFile"
              Source="$(var.PayloadDir)\docs\RELEASE.md" KeyPath="yes" />
      </Component>
      <Component Id="RwStabilityGuide" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E0C}">
        <File Id="RwStabilityGuideFile"
              Source="$(var.PayloadDir)\docs\RW_STABILITY.md" KeyPath="yes" />
      </Component>
      <Component Id="CliGuide" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E0D}">
        <File Id="CliGuideFile"
              Source="$(var.PayloadDir)\docs\UX.md" KeyPath="yes" />
      </Component>
      <Component Id="WindowsBlockDeviceGuide" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E0E}">
        <File Id="WindowsBlockDeviceGuideFile"
              Source="$(var.PayloadDir)\docs\WINDOWS_BLOCK_DEVICE.md" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- The official WinFsp license/notice text accompanies the installed
         product (FLOSS exception attribution); the bundle UI also shows this
         attribution in License.rtf. -->
    <DirectoryRef Id="NOTICESDIRECTORY">
      <Component Id="WinFspNotice" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E07}">
        <File Id="WinFspNoticeFile"
              Source="$(var.PayloadDir)\THIRD-PARTY-NOTICES\WinFsp-NOTICE.md"
              KeyPath="yes" />
        <RemoveFolder Id="RemoveNoticesDirectory" On="uninstall" />
      </Component>
      <Component Id="WinFspLicense" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E08}">
        <File Id="WinFspLicenseFile"
              Source="$(var.PayloadDir)\THIRD-PARTY-NOTICES\WinFsp-LICENSE.txt"
              KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyReadme" Guid="{6D0C7B0E-2C1A-4B7E-9F10-1A2B3C4D5E09}">
        <File Id="ThirdPartyReadmeFile"
              Source="$(var.PayloadDir)\THIRD-PARTY-NOTICES\README.md"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Start-menu Command Prompt and documentation shortcuts. -->
    <DirectoryRef Id="XfsWinMenuFolder">
      <Component Id="CommandPromptShortcut"
                 Guid="{C5C1B1F4-6F6A-4FF9-9A53-4E9D4C0E3B11}">
        <Shortcut Id="XfsWinCommandPrompt"
                  Name="XFS for Windows Command Prompt"
                  Description="Open a command prompt for the installed xfswin"
                  Target="[System64Folder]cmd.exe"
                  WorkingDirectory="APPLICATIONROOTDIRECTORY" />
        <RemoveFolder Id="XfsWinMenuFolderRemove" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\XFS-for-Windows\Components"
                       Name="CommandPromptShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="DocsShortcut"
                 Guid="{D3C2E0A7-8B4A-4E6D-9F1A-2C3B4D5E6F77}">
        <Shortcut Id="XfsWinDocs"
                  Name="XFS for Windows Documentation"
                  Description="Install, upgrade and automount guide"
                  Target="[#InstallGuideFile]"
                  WorkingDirectory="DOCSDIRECTORY" />
        <RegistryValue Root="HKLM" Key="Software\XFS-for-Windows\Components"
                       Name="DocsShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="XFS for Windows"
             Description="The xfswin command line, its service and documentation."
             Level="1">
      <ComponentRef Id="ProductRegistration" />
      <ComponentRef Id="XfswinExe" />
      <ComponentRef Id="ProductLicense" />
      <ComponentRef Id="ProductReadme" />
      <ComponentRef Id="ProductVersionJson" />
      <ComponentRef Id="InstallGuide" />
      <ComponentRef Id="InstallerGuide" />
      <ComponentRef Id="ReleaseGuide" />
      <ComponentRef Id="RwStabilityGuide" />
      <ComponentRef Id="CliGuide" />
      <ComponentRef Id="WindowsBlockDeviceGuide" />
      <ComponentRef Id="WinFspNotice" />
      <ComponentRef Id="WinFspLicense" />
      <ComponentRef Id="ThirdPartyReadme" />
      <ComponentRef Id="SystemPath" />
      <ComponentRef Id="CommandPromptShortcut" />
      <ComponentRef Id="DocsShortcut" />
    </Feature>

    <!-- Embedded maintenance helper.  Only prepare/rollback-quiesce/rollback/
         commit use this copy; they run before the payload exists or after it
         was rolled back.  Apply/verify/remove run the installed product. -->
    <Binary Id="XfsWinMaintenanceHelper" SourceFile="$(var.PayloadDir)\xfswin.exe" />

    <CustomAction Id="PrepareInstall" BinaryRef="XfsWinMaintenanceHelper"
                  ExeCommand="installer prepare --action install --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="PrepareUpgrade" BinaryRef="XfsWinMaintenanceHelper"
                  ExeCommand="installer prepare --action upgrade --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="PrepareUninstall" BinaryRef="XfsWinMaintenanceHelper"
                  ExeCommand="installer prepare --action uninstall --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- Apply/verify/remove use the installed product (after InstallFiles).
         The action name is passed explicitly because the helper compares it
         with the fence/capture written by prepare. -->
    <CustomAction Id="ApplyServiceInstall" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action install --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ApplyServiceUpgrade" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action upgrade --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="VerifyServiceInstall" FileRef="XfswinExeFile"
                  ExeCommand="installer verify --action install --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="VerifyServiceUpgrade" FileRef="XfswinExeFile"
                  ExeCommand="installer verify --action upgrade --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RemoveService" FileRef="XfswinExeFile"
                  ExeCommand="installer remove --action uninstall --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- Rollback has two ordered phases.
         quiesce (registered after RemoveExistingProducts and before apply, so
         MSI runs it before restoring the old product and files): clean-stop
         the service this transaction started or updated.  A running xfswin.exe
         image cannot be replaced, so this must happen while the new files are
         still on disk.
         The helper is a no-op when apply/remove never reached the service step
         (for example an upgrade refused because mounts were still live).
         restore (registered before prepare, so MSI runs it last): after the
         old files and, for an upgrade, the old product are back, restore the
         captured SCM configuration and running state, or delete a service this
         transaction created.  Both use the Binary helper because the
         installed executable may be the failed payload or already reverted.
         Their sequence conditions exclude the old package's nested uninstall
         during RemoveExistingProducts. -->
    <CustomAction Id="RollbackQuiesceService" BinaryRef="XfsWinMaintenanceHelper"
                  ExeCommand="installer rollback-quiesce --action auto --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="RollbackRestoreService" BinaryRef="XfsWinMaintenanceHelper"
                  ExeCommand="installer rollback --action auto --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="rollback" Impersonate="no" Return="check" />

    <!-- Commit uses the elevated commit script: it runs in the server when the
         whole transaction commits and never on a failed install.  The helper
         takes the install/upgrade/uninstall operation from the fence and
         capture that prepare wrote.  Its sequence condition excludes the old
         package's nested uninstall, whose commit would otherwise clear the new
         package's fence and capture before the new package commits.  An
         immediate action after InstallFinalize is not part of the elevated
         execute sequence. -->
    <CustomAction Id="CommitService" BinaryRef="XfsWinMaintenanceHelper"
                  ExeCommand="installer commit --action auto --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot;"
                  Execute="commit" Impersonate="no" Return="check" />

    <!--
      Opt-in deferred failure injection for installer tests.  The helper's
      documented installer-only fail switch runs inside the real deferred
      apply/verify actions after InstallFiles.  Each stage fails
      deterministically, so Windows Installer rolls back files, PATH and the
      service.  This flag never reaches the filesystem layer.
      Values: before-service, after-files, service-start, verify.
      verify lets apply complete and start the service, then makes the
      standalone verify action fail, so the rollback stop phase is exercised
      against a running service.
    -->
    <CustomAction Id="TestApplyBeforeServiceInstall" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action install --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail before-service"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestApplyBeforeServiceUpgrade" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action upgrade --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail before-service"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestApplyAfterFilesInstall" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action install --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail after-files"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestApplyAfterFilesUpgrade" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action upgrade --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail after-files"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestApplyServiceStartInstall" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action install --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail service-start"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestApplyServiceStartUpgrade" FileRef="XfswinExeFile"
                  ExeCommand="installer apply --action upgrade --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail service-start"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestVerifyAfterApplyInstall" FileRef="XfswinExeFile"
                  ExeCommand="installer verify --action install --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail verify"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestVerifyAfterApplyUpgrade" FileRef="XfswinExeFile"
                  ExeCommand="installer verify --action upgrade --install-path &quot;[APPLICATIONROOTDIRECTORY]\xfswin.exe&quot; --fail verify"
                  Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <!-- Transaction branches:
           fresh     NOT Installed AND NOT WIX_UPGRADE_DETECTED
           upgrade   WIX_UPGRADE_DETECTED
           uninstall Installed AND REMOVE=ALL
           Every branch also requires NOT UPGRADINGPRODUCTCODE, which skips
           the old package's actions during RemoveExistingProducts. -->

      <!-- Rollback restore phase.  Registered before prepare runs, so at
           rollback time MSI executes it last: every later system change,
           including InstallFiles and RemoveExistingProducts, has already been
           undone and the original xfswin.exe is back on disk.  Only then is
           the captured SCM configuration and running state restored (or a
           service created by this transaction deleted).  The helper reads the
           operation from the captured rollback state.  The condition is
           evaluated when the script is built; NOT UPGRADINGPRODUCTCODE keeps
           the old package's nested uninstall from restoring the new package's
           captured state.  Anchoring after InstallInitialize (the earliest
           legal position) also makes it register before prepare can fail. -->
      <Custom Action="RollbackRestoreService" After="InstallInitialize"
              Condition="NOT UPGRADINGPRODUCTCODE" />

      <!-- Maintenance fence.  Prepare is a deferred, elevated action, so the
           server executes it at this sequence point, after InstallInitialize
           (the earliest legal position) and well before InstallFiles.  With
           RemoveExistingProducts scheduled afterInstallExecute the old product
           still exists here, so prepare can stop its service and drain its
           sessions.  Return="check" aborts the upgrade while the old product
           and its service are still present if the fence, service stop or
           session drain fails. -->
      <Custom Action="PrepareUpgrade" After="RollbackRestoreService"
              Condition="WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PrepareInstall" After="RollbackRestoreService"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PrepareUninstall" After="RollbackRestoreService"
              Condition="Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND (REMOVE=&quot;ALL&quot; OR REMOVE~=&quot;ALL&quot;)" />

      <!-- Rollback stop phase.  Register after both InstallFiles and the old
           product's nested uninstall, before any apply/test action can start
           the new service.  MSI rolls back in reverse registration order: the
           new service releases xfswin.exe before either the old product or its
           files are restored.  A failure in prepare or old-product removal
           occurs before apply and needs only the earlier restore phase. -->
      <!-- The active package always registers this stop action (the condition
           is evaluated at script build time); the helper is a no-op when the
           transaction never reached the service step and derives the
           transaction from the fence/capture.  NOT UPGRADINGPRODUCTCODE keeps
           the old package's nested uninstall from touching the new
           transaction's service. -->
      <Custom Action="RollbackQuiesceService" After="RemoveExistingProducts"
              Condition="NOT UPGRADINGPRODUCTCODE" />

      <!--
        Opt-in failure injection.  Normal apply/verify run only when
        XFSWIN_TEST_FAIL is empty; a test stage runs the real helper apply or
        verify with the fail switch at this deferred point instead, so the MSI rollback
        (files, PATH and service) is exercised.  With XFSWIN_TEST_FAIL=verify,
        apply runs normally and the separate verify action fails, leaving the
        started service for the rollback stop phase to quiesce.  A launch
        condition rejects unknown values, so a typo cannot silently skip both
        paths.
      -->
      <Custom Action="TestApplyBeforeServiceInstall" After="RollbackQuiesceService"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;before-service&quot;" />
      <Custom Action="TestApplyBeforeServiceUpgrade" After="RollbackQuiesceService"
              Condition="WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;before-service&quot;" />
      <Custom Action="TestApplyAfterFilesInstall" After="RollbackQuiesceService"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;after-files&quot;" />
      <Custom Action="TestApplyAfterFilesUpgrade" After="RollbackQuiesceService"
              Condition="WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;after-files&quot;" />
      <Custom Action="TestApplyServiceStartInstall" After="RollbackQuiesceService"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;service-start&quot;" />
      <Custom Action="TestApplyServiceStartUpgrade" After="RollbackQuiesceService"
              Condition="WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;service-start&quot;" />

      <!-- Apply/verify (installed product).  Fresh install applies after
           InstallFiles.  An upgrade applies after RemoveExistingProducts: the
           old product is gone by then, so the old package's nested uninstall
           cannot delete or reconfigure the service this action creates.  For
           the verify failure-injection stage apply takes the normal path. -->
      <Custom Action="ApplyServiceInstall" After="RollbackQuiesceService"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND (XFSWIN_TEST_FAIL=&quot;&quot; OR XFSWIN_TEST_FAIL=&quot;verify&quot;)" />
      <Custom Action="ApplyServiceUpgrade" After="RollbackQuiesceService"
              Condition="WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND (XFSWIN_TEST_FAIL=&quot;&quot; OR XFSWIN_TEST_FAIL=&quot;verify&quot;)" />
      <Custom Action="VerifyServiceInstall" After="ApplyServiceInstall"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;&quot;" />
      <Custom Action="VerifyServiceUpgrade" After="ApplyServiceUpgrade"
              Condition="WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;&quot;" />
      <Custom Action="TestVerifyAfterApplyInstall" After="ApplyServiceInstall"
              Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;verify&quot;" />
      <Custom Action="TestVerifyAfterApplyUpgrade" After="ApplyServiceUpgrade"
              Condition="WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND XFSWIN_TEST_FAIL=&quot;verify&quot;" />

      <!-- Uninstall: clean-stop owned sessions and remove the owned service
           before any product file is removed; remove verifies it is gone. -->
      <Custom Action="RemoveService" Before="RemoveFiles"
              Condition="Installed AND NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE AND (REMOVE=&quot;ALL&quot; OR REMOVE~=&quot;ALL&quot;)" />

      <!-- Final success only.  The elevated commit action runs when the whole
           script commits and never on a failed install, so the fence stays for
           rollback.  The condition is evaluated when the script is built:
           NOT UPGRADINGPRODUCTCODE prevents the old package's nested uninstall
           commit from clearing the new package's fence and capture.  Within
           the active package the helper resolves install/upgrade/uninstall
           from the fence and capture prepare wrote. -->
      <Custom Action="CommitService" After="InstallInitialize"
              Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Launch Condition="VersionNT64" Message="XFS for Windows requires 64-bit Windows." />
    <Launch Condition="Privileged" Message="XFS for Windows requires administrator approval." />
    <Launch Condition="XFSWIN_TEST_FAIL=&quot;&quot; OR XFSWIN_TEST_FAIL=&quot;before-service&quot; OR XFSWIN_TEST_FAIL=&quot;after-files&quot; OR XFSWIN_TEST_FAIL=&quot;service-start&quot; OR XFSWIN_TEST_FAIL=&quot;verify&quot;"
            Message="XFSWIN_TEST_FAIL must be before-service, after-files, service-start or verify." />
  </Package>
</Wix>
