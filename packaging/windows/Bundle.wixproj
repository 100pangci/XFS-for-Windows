<Project Sdk="WixToolset.Sdk/7.0.1">
  <!--
    REL-1 native Burn bundle for XFS for Windows.

    MSBuild inputs (scripts/release/build-packages.ps1 supplies them with
    `dotnet build -c Release`):
      Platform        x64 | arm64 (native Burn engine/BA/setup)
      ProductVersion  numeric project() version, e.g. 0.1.0
      ProductMsi      internal per-machine MSI produced by Product.wixproj
      WinFspMsi       verified official WinFsp 2.1.25156 MSI
      OutputPath      MSBuild output directory (absolute, outside the repo)

    The extensions are pinned to the same WiX 7.0.1 toolset version as the
    SDK; NuGet restore is redirected into the isolated tool cache by the
    caller (NUGET_PACKAGES/RestoreSources).
  -->
  <PropertyGroup>
    <InstallerPlatform Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'X64'">x64</InstallerPlatform>
    <InstallerPlatform Condition="'$(Platform)' == 'arm64' OR '$(Platform)' == 'ARM64'">arm64</InstallerPlatform>
    <OutputType>Bundle</OutputType>
    <OutputName>xfswin-$(ProductVersion)-windows-$(InstallerPlatform)-setup</OutputName>
    <WinFspMinimumVersion Condition="'$(WinFspMinimumVersion)' == ''">2.1.25156</WinFspMinimumVersion>
    <DefineConstants>ProductVersion=$(ProductVersion);ProductArchitecture=$(InstallerPlatform);ProductMsi=$(ProductMsi);WinFspMsi=$(WinFspMsi);WinFspMinimumVersion=$(WinFspMinimumVersion);LicenseRtf=$(MSBuildProjectDirectory)\License.rtf</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- Bundle.wxs is the only source for this project; Product.wxs lives in
         the same directory and the WiX SDK's default Compile glob
         (**/*.wxs, controlled by EnableDefaultCompileItems in tools/wix.props)
         would otherwise add both.  MSBuild evaluates properties before items,
         so the project-body value suppresses the SDK item. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.1" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.1" />
  </ItemGroup>

  <Target Name="ValidateBundleInputs" BeforeTargets="BeforeBuild">
    <Error Condition="'$(InstallerPlatform)' != 'x64' AND '$(InstallerPlatform)' != 'arm64'"
           Text="Platform must be the native x64 or arm64 platform (got '$(Platform)')." />
    <Error Condition="'$(ProductVersion)' == ''"
           Text="ProductVersion is required (the numeric CMake project version)." />
    <Error Condition="'$(ProductMsi)' == '' Or !Exists('$(ProductMsi)')"
           Text="ProductMsi does not exist: '$(ProductMsi)'" />
    <Error Condition="'$(WinFspMsi)' == '' Or !Exists('$(WinFspMsi)')"
           Text="WinFspMsi does not exist: '$(WinFspMsi)'" />
  </Target>

  <!-- build-packages.ps1 looks for the setup executable directly in OutputPath
       (non-recursively).  Keep that contract even if the SDK places the
       bundle in a platform subdirectory. -->
  <Target Name="CopyBundleExecutable" AfterTargets="Build">
    <ItemGroup>
      <_XfsWinBuiltBundle Include="$(OutputPath)**\$(OutputName).exe" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(OutputPath)$(OutputName).exe"
          Condition="Exists('$(TargetPath)') And '$(TargetPath)' != '$(OutputPath)$(OutputName).exe'" />
    <Copy SourceFiles="@(_XfsWinBuiltBundle)" DestinationFiles="$(OutputPath)$(OutputName).exe"
          Condition="!Exists('$(OutputPath)$(OutputName).exe') And '@(_XfsWinBuiltBundle)' != ''" />
  </Target>
</Project>
