<?xml version="1.0" encoding="utf-8"?>
<!--
  XFS for Windows REL-1 Burn bundle (setup.exe).

  The bundle is native for the target architecture: the Burn engine, the
  standard bootstrapper application and the setup PE are built as native x64
  or native arm64 (never x86, ARM64EC or a renamed ZIP).

  Chain order: the pinned, unmodified official WinFsp 2.1.25156 MSI first
  (shared system dependency), then the XFS for Windows per-machine MSI.  The
  WinFsp package is Permanent: ordinary uninstall retains it even if this
  setup installed it.  A compatible WinFsp 2.x that is already present is
  accepted and never downgraded; the product MSI's real runtime validation
  (installer apply/verify) is authoritative.

  Unsupported/missing-major handling:
    absent                   -> install the pinned official MSI (silent)
    2.x older than pinned    -> upgrade to the pinned official MSI
    2.x equal or newer       -> keep it; do not downgrade
    1.x or >=3.x             -> refuse before the chain runs, with a clear
                                remove-and-restart message

  Uninstall is never blocked by the runtime condition: an unsupported WinFsp
  must not be able to strand the product on the machine.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- WiX v4+ has no Bundle Scope attribute: Burn derives the bundle scope
       from the chained packages.  Both packages are per-machine, so this is a
       per-machine bundle. -->
  <Bundle Name="XFS for Windows"
          Version="$(var.ProductVersion)"
          Manufacturer="XFS-for-Windows contributors"
          UpgradeCode="{A1B2C3D4-E5F6-47A8-9B0C-1D2E3F4A5B6C}"
          Compressed="yes"
          DisableModify="yes">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          LicenseFile="$(var.LicenseRtf)"
          SuppressOptionsUI="yes"
          SuppressRepair="yes" />
    </BootstrapperApplication>

    <Log Prefix="XFSWin" />

    <!-- The official WinFsp MSI's ProductCode/UpgradeCode are fixed
         ({C79D9B29-...} / {5466A3D8-...}).  The search is by the WinFsp
         UpgradeCode and returns the highest installed version, or an empty
         value/0.0.0.0 when the dependency is absent. -->
    <util:ProductSearch Id="WinFspProductSearch"
                        Variable="WINFSP_VERSION"
                        UpgradeCode="{5466A3D8-3AA1-4240-B6A0-3A051940A3EC}"
                        Result="version" />

    <bal:Condition
        Condition="WixBundleInstalled OR ((WINFSP_VERSION = &quot;&quot; OR WINFSP_VERSION = &quot;0.0.0.0&quot;) OR (WINFSP_VERSION &gt;= v2.0 AND WINFSP_VERSION &lt; v3.0))"
        Message="XFS for Windows requires the official WinFsp 2.x runtime. An unsupported WinFsp version is installed. Remove it, restart Windows, and run this setup again. See docs/INSTALL.md for the pinned official runtime." />

    <Chain>
      <MsiPackage Id="WinFspRuntime"
                  SourceFile="$(var.WinFspMsi)"
                  Compressed="yes"
                  Vital="yes"
                  Permanent="yes"
                  InstallCondition="(WINFSP_VERSION = &quot;&quot; OR WINFSP_VERSION = &quot;0.0.0.0&quot;) OR (WINFSP_VERSION &gt;= v2.0 AND WINFSP_VERSION &lt; v$(var.WinFspMinimumVersion))" />

      <MsiPackage Id="XfsWinProduct"
                  SourceFile="$(var.ProductMsi)"
                  Compressed="yes"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
